datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String        @db.VarChar(120)
  balanceMinor         BigInt        @default(0) @map("balance_minor")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  transactions         Transaction[]
  sourceTransfers      Transfer[]    @relation("SourceTransfers")
  destinationTransfers Transfer[]    @relation("DestinationTransfers")

  @@map("accounts")
}

model Transaction {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  type        String    @db.VarChar(10)
  amountMinor BigInt    @map("amount_minor")
  description String    @db.VarChar(500)
  referenceId String    @map("reference_id") @db.VarChar(128)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  transferId  String?   @map("transfer_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer    Transfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@unique([accountId, referenceId])
  @@index([accountId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("transactions")
}

model Transfer {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceAccountId      String        @map("source_account_id") @db.Uuid
  destinationAccountId String        @map("destination_account_id") @db.Uuid
  amountMinor          BigInt        @map("amount_minor")
  description          String        @db.VarChar(500)
  referenceId          String        @map("reference_id") @db.VarChar(128)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceAccount        Account       @relation("SourceTransfers", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount   Account       @relation("DestinationTransfers", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  transactions         Transaction[]

  @@unique([sourceAccountId, referenceId])
  @@map("transfers")
}
